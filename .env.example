# GEMINI_API_KEY: Server-side Gemini API key for property valuation and legal advisory
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The base public URL for this deployment
APP_URL="http://localhost:3000"

# DATABASE_URL: Neon Serverless PostgreSQL Database Connection String
# Get this from your Neon console (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# JWT_SECRET: Secret key for signing authentication tokens
JWT_SECRET="nigeria_property_centre_jwt_secret_key_change_in_production"
